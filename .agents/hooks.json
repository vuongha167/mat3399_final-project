{
  "sound-alerts": {
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "pw-play /usr/share/sounds/sound-icons/prompt.wav >/dev/null 2>&1; echo '{\"decision\": \"allow\"}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "pw-play /usr/share/sounds/sound-icons/trumpet-12.wav >/dev/null 2>&1; echo '{}'"
      }
    ]
  }
}
